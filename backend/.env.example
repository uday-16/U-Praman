# ==============================================================================
# PRAMAN BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# Database Configuration (Local MongoDB Compass or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=praman

# Security & Tokens
JWT_SECRET=sih26108_jwt_secret_key_standards_ai
SECRET_KEY=sih26108_secret_key_standards_ai_procurement

# Gmail SMTP Configuration (Email OTP Only)
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=praman.standards@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
SMTP_FROM_EMAIL=praman.standards@gmail.com
SMTP_FROM_NAME=PRAMAN Standards
SMTP_USE_TLS=true

# AI & LLM Reasoning Configuration (Optional - for enhanced reasoning over RAG context)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
# Empty selects backend/datab, falling back to the repository datab directory.
STANDARDS_DATA_DIR=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_SEMANTIC_ENABLED=true
GOOGLE_CLIENT_ID=
# Optional first-administrator provisioning. No account is seeded without both values.
# Use a unique password of at least 12 characters; remove these values after provisioning.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
